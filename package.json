{
  "name": "@camkerber/typescript-dsa",
  "description": "Implementations of various data structures and algorithms with TypeScript",
  "author": "camkerber",
  "license": "MIT",
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data-structures": {
      "types": "./dist/data-structures/index.d.ts",
      "default": "./dist/data-structures/index.js"
    },
    "./algorithms": {
      "types": "./dist/algorithms/index.d.ts",
      "default": "./dist/algorithms/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "ci:check": "tsc --noEmit && eslint . && prettier . --check && jest",
    "ci:publish": "pnpm build && pnpm changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.24.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
